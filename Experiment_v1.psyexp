      <CodeComponent name="code_3" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="send_marker(&quot;baseline_begin&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="sent_2min = False&amp;#10;# 1. 取得當前本地精準時間&amp;#10;now_iso = datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')&amp;#10;now_epoch = time.time()&amp;#10;&amp;#10;# 2. 發送 Marker 代碼&amp;#10;marker_code = '220'&amp;#10;send_marker(marker_code)&amp;#10;&amp;#10;# 3. 即時寫入 log/ 資料夾下的 CSV&amp;#10;with open(log_filename, mode='a', newline='', encoding='utf-8-sig') as f:&amp;#10;    writer = csv.writer(f)&amp;#10;    writer.writerow([&amp;#10;        participant_id,&amp;#10;        session_id,&amp;#10;        0,&amp;#10;        &quot;Baseline_Exper_Begin&quot;,&amp;#10;        marker_code,&amp;#10;        now_iso,&amp;#10;        f&quot;{now_epoch:.6f}&quot;,&amp;#10;        f&quot;{t:.4f}&quot;&amp;#10;    ])&amp;#10;&amp;#10;# 控制台除錯印出&amp;#10;print(f&quot;[Log Saved] Sub: {participant_id} | Sess: {session_id} | Event: Baseline_Exper_Begin | Time: {now_iso}&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="if not sent_2min and t &gt;= 120:&amp;#10;    # 1. 取得當前本地精準時間&amp;#10;    now_iso = datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')&amp;#10;    now_epoch = time.time()&amp;#10;&amp;#10;    # 2. 發送 Marker 代碼&amp;#10;    marker_code = '221'&amp;#10;    send_marker(marker_code)&amp;#10;&amp;#10;    # 3. 即時寫入 log/ 資料夾下的 CSV&amp;#10;    with open(log_filename, mode='a', newline='', encoding='utf-8-sig') as f:&amp;#10;        writer = csv.writer(f)&amp;#10;        writer.writerow([&amp;#10;            participant_id,&amp;#10;            session_id,&amp;#10;            0,&amp;#10;            &quot;Baseline_Exper_End&quot;,&amp;#10;            marker_code,&amp;#10;            now_iso,&amp;#10;            f&quot;{now_epoch:.6f}&quot;,&amp;#10;            f&quot;{t:.4f}&quot;&amp;#10;        ])&amp;#10;&amp;#10;    # 控制台除錯印出&amp;#10;    print(f&quot;[Log Saved] Sub: {participant_id} | Sess: {session_id} | Event: Baseline_Exper_End | Time: {now_iso}&quot;)&amp;#10;    &amp;#10;    # 2. 發送 Marker 代碼&amp;#10;    marker_code = '310'&amp;#10;    send_marker(marker_code)&amp;#10;&amp;#10;    # 3. 即時寫入 log/ 資料夾下的 CSV&amp;#10;    with open(log_filename, mode='a', newline='', encoding='utf-8-sig') as f:&amp;#10;        writer = csv.writer(f)&amp;#10;        writer.writerow([&amp;#10;            participant_id,&amp;#10;            session_id,&amp;#10;            0,&amp;#10;            &quot;Breath_Pre_Begin&quot;,&amp;#10;            marker_code,&amp;#10;            now_iso,&amp;#10;            f&quot;{now_epoch:.6f}&quot;,&amp;#10;            f&quot;{t:.4f}&quot;&amp;#10;        ])&amp;#10;&amp;#10;    # 控制台除錯印出&amp;#10;    print(f&quot;[Log Saved] Sub: {participant_id} | Sess: {session_id} | Event: Breath_Pre_Begin | Time: {now_iso}&quot;)&amp;#10;    sent_2min = True" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="send_marker(&quot;baseline_end&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="# 1. 取得當前本地精準時間&amp;#10;now_iso = datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')&amp;#10;now_epoch = time.time()&amp;#10;&amp;#10;# 2. 發送 Marker 代碼&amp;#10;marker_code = '311'&amp;#10;send_marker(marker_code)&amp;#10;&amp;#10;# 3. 即時寫入 log/ 資料夾下的 CSV&amp;#10;with open(log_filename, mode='a', newline='', encoding='utf-8-sig') as f:&amp;#10;    writer = csv.writer(f)&amp;#10;    writer.writerow([&amp;#10;        participant_id,&amp;#10;        session_id,&amp;#10;        0,&amp;#10;        &quot;Breath_Pre_End&quot;,&amp;#10;        marker_code,&amp;#10;        now_iso,&amp;#10;        f&quot;{now_epoch:.6f}&quot;,&amp;#10;        f&quot;{t:.4f}&quot;&amp;#10;    ])&amp;#10;&amp;#10;# 控制台除錯印出&amp;#10;print(f&quot;[Log Saved] Sub: {participant_id} | Sess: {session_id} | Event: Breath_Pre_End | Time: {now_iso}&quot;)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code_3" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
