        <Param val="# 1. 取得當前本地精準時間&amp;#10;now_iso = datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')&amp;#10;now_epoch = time.time()&amp;#10;&amp;#10;# 2. 發送 Marker 代碼&amp;#10;marker_code = '200'&amp;#10;send_marker(marker_code)&amp;#10;&amp;#10;# 3. 即時寫入 log/ 資料夾下的 CSV&amp;#10;with open(log_filename, mode='a', newline='', encoding='utf-8-sig') as f:&amp;#10;    writer = csv.writer(f)&amp;#10;    writer.writerow([&amp;#10;        participant_id,&amp;#10;        session_id,&amp;#10;        0,&amp;#10;        &quot;Baseline_Instr&quot;,&amp;#10;        marker_code,&amp;#10;        now_iso,&amp;#10;        f&quot;{now_epoch:.6f}&quot;,&amp;#10;        f&quot;{t:.4f}&quot;&amp;#10;    ])&amp;#10;&amp;#10;# 控制台除錯印出&amp;#10;print(f&quot;[Log Saved] Sub: {participant_id} | Sess: {session_id} | Event: Baseline_Instr | Time: {now_iso}&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
