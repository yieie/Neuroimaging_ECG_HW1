        <Param val="True" valType="bool" updates="constant" name="syncScreenRefresh"/>
      </KeyboardComponent>
      <CodeComponent name="code" plugin="None">
        <Param val="import csv&amp;#10;import os&amp;#10;from datetime import datetime&amp;#10;&amp;#10;# 1. 自動建立 log 資料夾 (如果資料夾不存在，會自動創建)&amp;#10;log_dir = 'marker_log'&amp;#10;if not os.path.exists(log_dir):&amp;#10;    os.makedirs(log_dir)&amp;#10;" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="import threading&amp;#10;import time&amp;#10;import urllib.parse&amp;#10;import urllib.request&amp;#10;&amp;#10;def send_marker(label):&amp;#10;    &quot;&quot;&quot;送 marker 到 WebPolarReader，並把精確時間存進 PsychoPy 的 csv。&amp;#10;    用背景執行緒送出，不會卡住畫面。&quot;&quot;&quot;&amp;#10;    t = time.time()                       # 系統時間（秒），與 marker 的毫秒時間同一個時鐘&amp;#10;    thisExp.addData(label + '_epoch', t)  # PsychoPy csv 也留一份精確時間&amp;#10;    full = f&quot;{label}&quot;             # marker 名稱附上 PsychoPy 的時間，方便事後核對&amp;#10;    url = &quot;http://localhost:8765/marker?label=&quot; + urllib.parse.quote(full)&amp;#10;    def _go():&amp;#10;        try:&amp;#10;            urllib.request.urlopen(url, timeout=1)&amp;#10;        except Exception as e:&amp;#10;            print(&quot;marker 送出失敗：&quot;, label, e)&amp;#10;    threading.Thread(target=_go, daemon=True).start()&amp;#10;    &amp;#10;&amp;#10;# 自動抓取 Runner 開啟時填寫的 Participant 與 Session&amp;#10;# 若填寫留空，會給予預設值 'anonymous' 與 '1'&amp;#10;participant_id = expInfo.get('participant', 'anonymous')&amp;#10;session_id = expInfo.get('session', '1')&amp;#10;&amp;#10;# 組合檔名並放在 maker_log/ 資料夾下&amp;#10;# 範例檔名: maker_log/sub-P001_sess-01_marker_20261014_112500.csv&amp;#10;time_str = datetime.now().strftime('%Y%m%d_%H%M%S')&amp;#10;log_filename = os.path.join(log_dir, f&quot;sub-{participant_id}_sess-{session_id}_marker_{time_str}.csv&quot;)&amp;#10;&amp;#10;# 開啟檔案並寫入標題欄位 (Header)&amp;#10;with open(log_filename, mode='w', newline='', encoding='utf-8-sig') as f:&amp;#10;    writer = csv.writer(f)&amp;#10;    writer.writerow([&amp;#10;        'Participant',            # 受試者 ID&amp;#10;        'Session',                # 場次 ID&amp;#10;        'Trial_Index',            # 循環/試驗次數&amp;#10;        'Event_Name',             # 事件名稱 (如: Inhale, Exhale, Deflate)&amp;#10;        'Marker_Code',            # Marker 編號&amp;#10;        'Local_ISO_Time',         # 本地 ISO 時間 (與網站/雲端 timestamp 對齊)&amp;#10;        'Local_Epoch_Time',       # 本地 Epoch 時間 (浮點數，方便做秒數扣減)&amp;#10;        'PsychoPy_Relative_t'     # Routine 內的相對時間 (t)&amp;#10;    ])&amp;#10;&amp;#10;print(f&quot;[Log Setup] 成功建立紀錄檔：{log_filename}&quot;)" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="import * as threading from 'threading';&amp;#10;import * as time from 'time';&amp;#10;import * as urllib.parse from 'urllib/parse';&amp;#10;import * as urllib.request from 'urllib/request';&amp;#10;function send_marker(label) {&amp;#10;    /*送 marker 到 WebPolarReader，並把精確時間存進 PsychoPy 的 csv。&amp;#10;    用背景執行緒送出，不會卡住畫面。*/&amp;#10;    var full, t, url;&amp;#10;    t = time.time();&amp;#10;    psychoJS.experiment.addData((label + &quot;_epoch&quot;), t);&amp;#10;    full = `${label}|${util.pad(Number.parseFloat(t).toFixed(3), 1)}`;&amp;#10;    url = (&quot;http://localhost:8765/marker?label=&quot; + urllib.parse.quote(full));&amp;#10;    function _go() {&amp;#10;        try {&amp;#10;            urllib.request.urlopen(url, {&quot;timeout&quot;: 1});&amp;#10;        } catch(e) {&amp;#10;            console.log(&quot;marker \u9001\u51fa\u5931\u6557\uff1a&quot;, label, e);&amp;#10;        }&amp;#10;    }&amp;#10;    new threading.Thread({&quot;target&quot;: _go, &quot;daemon&quot;: true}).start();&amp;#10;}&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="send_marker(&quot;exper_begin&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="## 1. 取得當前本地精準時間&amp;#10;#now_iso = datetime.now().strftime('%Y-%m-%d %H:%M:%S.%f')&amp;#10;#now_epoch = time.time()&amp;#10;#&amp;#10;## 2. 發送 Marker 代碼&amp;#10;#marker_code = '100'&amp;#10;#send_marker(marker_code)&amp;#10;#&amp;#10;## 3. 即時寫入 log/ 資料夾下的 CSV&amp;#10;#with open(log_filename, mode='a', newline='', encoding='utf-8-sig') as f:&amp;#10;#    writer = csv.writer(f)&amp;#10;#    writer.writerow([&amp;#10;#        participant_id,&amp;#10;#        session_id,&amp;#10;#        0,&amp;#10;#        &quot;Exper_Begin&quot;,&amp;#10;#        marker_code,&amp;#10;#        now_iso,&amp;#10;#        f&quot;{now_epoch:.6f}&quot;,&amp;#10;#        f&quot;{t:.4f}&quot;&amp;#10;#    ])&amp;#10;#&amp;#10;## 控制台除錯印出&amp;#10;#print(f&quot;[Log Saved] Sub: {participant_id} | Sess: {session_id} | Event: Exper_Begin | Time: {now_iso}&quot;)" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Py" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="End JS Experiment"/>
        <Param val="send_marker(&quot;instr_end&quot;);&amp;#10;" valType="extendedCode" updates="constant" name="End JS Routine"/>
        <Param val="" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
        <Param val="code" valType="code" updates="None" name="name"/>
      </CodeComponent>
    </Routine>
